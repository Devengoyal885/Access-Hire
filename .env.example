# Environment Variables for AccessHire

# ── AI Providers (all optional — realistic mocks used when absent) ──────────

# OpenAI / ChatGPT
OPENAI_API_KEY=

# Google Gemini
GOOGLE_GEMINI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# ── Database (optional — mock data used when absent) ───────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/accesshire

# ── Application ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth (optional — mock auth used in demo mode) ─────────────────────────

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ── Feature Flags ─────────────────────────────────────────────────────────

NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_AI_MOCK_RESPONSES=true
